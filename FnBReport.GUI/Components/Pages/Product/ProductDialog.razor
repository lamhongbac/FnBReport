@using FnBReport.GUI.ViewModels
@using FnBReport.GUI.Services
@inject IProductAppService ProductService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <EditForm Model="@Model" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Number" Label="Mã Sản phẩm" For="@(() => Model.Number)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Name" Label="Tên Sản phẩm" For="@(() => Model.Name)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <div class="d-flex align-center gap-2">
                        <!-- GroupCode maps to ProductGroup.Number -->
                        <MudSelect T="string" @bind-Value="Model.GroupCode" Label="Nhóm Sản phẩm" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                            @foreach (var g in Groups)
                            {
                                <MudSelectItem Value="@g.Number">@g.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="OpenQuickAddGroup" title="Thêm nhanh Nhóm SP" Class="mt-1" />
                    </div>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Unit" Label="Đơn vị tính" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="Model.SellingPrice" Label="Giá bán" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="Model.Cosprice" Label="Giá vốn" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Hủy</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnValidSubmit">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ProductViewModel Model { get; set; } = new();
    private IEnumerable<ProductGroupViewModel> Groups = new List<ProductGroupViewModel>();

    protected override async Task OnInitializedAsync()
    {
        Groups = await ProductService.GetAllProductGroupsAsync();
    }

    private async Task OpenQuickAddGroup()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ProductGroupDialog>("Thêm Nhóm Sản phẩm", options);
        var result = await dialog.Result;
        
        if (!result.Canceled && result.Data != null)
        {
            var newGroup = result.Data as ProductGroupViewModel;
            if (newGroup != null && !string.IsNullOrEmpty(newGroup.Number))
            {
                Groups = await ProductService.GetAllProductGroupsAsync();
                Model.GroupCode = newGroup.Number;
                StateHasChanged();
            }
        }
    }

    private async Task OnValidSubmit()
    {
        var result = await ProductService.SaveProductAsync(Model, "admin");
        if (result.OK)
        {
            Snackbar.Add("Lưu thành công", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add(result.Message, Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
