@page "/products"
@using FnBReport.GUI.ViewModels
@using FnBReport.GUI.Services
@inject IProductAppService ProductService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IExcelService ExcelService
@inject IJSRuntime JS

<MudText Typo="Typo.h5" Class="mb-4">Quản lý Sản phẩm</MudText>

<div class="d-flex gap-2 mb-2">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => OpenDialog())">Thêm mới</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="DownloadTemplate">Tải Template</MudButton>
    <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles" Accept=".xlsx">
        <ActivatorContent>
            <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.Upload">Nhập Excel</MudButton>
        </ActivatorContent>
    </MudFileUpload>
</div>

@if (previewData != null && previewData.Any())
{
    <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Primary">Xem trước dữ liệu Nhập Excel</MudText>
    
    <div class="d-flex gap-2 mb-4">
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ConfirmImport" StartIcon="@Icons.Material.Filled.Check">Xác nhận Import</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="CancelImport" StartIcon="@Icons.Material.Filled.Close">Hủy</MudButton>
    </div>

    <MudDataGrid Items="@previewData" Hover="true">
        <Columns>
            <PropertyColumn Property="x => x.Number" Title="Mã SP" />
            <PropertyColumn Property="x => x.Name" Title="Tên Sản phẩm" />
            <PropertyColumn Property="x => x.GroupCode" Title="Nhóm SP" />
            <PropertyColumn Property="x => x.SellingPrice" Title="Giá bán" Format="N0" />
            <PropertyColumn Property="x => x.Cosprice" Title="Giá vốn" Format="N0" />
        </Columns>
    </MudDataGrid>
}
else
{
    <MudDataGrid Items="@Products" Filterable="true" SortMode="SortMode.Multiple" Groupable="true">
        <Columns>
            <PropertyColumn Property="x => x.Number" Title="Mã SP" />
            <PropertyColumn Property="x => x.Name" Title="Tên Sản phẩm" />
            <PropertyColumn Property="x => x.GroupCode" Title="Nhóm SP" />
            <PropertyColumn Property="x => x.SellingPrice" Title="Giá bán" Format="N0" />
            <PropertyColumn Property="x => x.Cosprice" Title="Giá vốn" Format="N0" />
            <TemplateColumn Title="Thao tác">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() => OpenDialog(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => Delete(context.Item.Id))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}

@code {
    private IEnumerable<ProductViewModel> Products = new List<ProductViewModel>();
    private List<ProductViewModel>? previewData = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        Products = await ProductService.GetAllProductsAsync();
    }

    private async Task OpenDialog(ProductViewModel? item = null)
    {
        var parameters = new DialogParameters();
        if (item != null)
        {
            parameters.Add("Model", new ProductViewModel 
            { 
                Id = item.Id, Number = item.Number, Name = item.Name, 
                GroupCode = item.GroupCode, Unit = item.Unit,
                Cosprice = item.Cosprice, SellingPrice = item.SellingPrice
            });
        }
        else
        {
            parameters.Add("Model", new ProductViewModel());
        }

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ProductDialog>("Thông tin Sản phẩm", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadData();
        }
    }

    private async Task Delete(int id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Xác nhận", "Bạn có chắc chắn muốn xóa sản phẩm này?", yesText: "Xóa", cancelText: "Hủy");
        if (confirm == true)
        {
            var result = await ProductService.DeleteProductAsync(id, "admin");
            if (result.OK)
            {
                Snackbar.Add("Xóa thành công", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(result.Message, Severity.Error);
            }
        }
    }

    private async Task DownloadTemplate()
    {
        var columns = new[] { "Mã SP", "Tên Sản phẩm", "Nhóm SP (Mã)", "Đơn vị tính", "Giá bán", "Giá vốn" };

        var groups = await ProductService.GetAllProductGroupsAsync();
        var refData = new List<string[]> { new[] { "Mã Nhóm", "Tên Nhóm" } };
        refData.AddRange(groups.Select(g => new[] { g.Number, g.Name }));
        var refSheets = new Dictionary<string, IEnumerable<string[]>> { { "Danh Sách Nhóm", refData } };

        var fileBytes = ExcelService.GenerateTemplate(columns, referenceSheets: refSheets);
        using var streamRef = new DotNetStreamReference(new MemoryStream(fileBytes));
        await JS.InvokeVoidAsync("downloadFileFromStream", "Template_SanPham.xlsx", streamRef);
    }

    private async Task UploadFiles(IBrowserFile file)
    {
        if (file == null) return;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var expectedColumns = new[] { "Mã SP", "Tên Sản phẩm", "Nhóm SP (Mã)", "Đơn vị tính", "Giá bán", "Giá vốn" };
            var data = ExcelService.ReadExcel(ms, expectedColumns);
            
            previewData = new List<ProductViewModel>();
            foreach (var row in data)
            {
                previewData.Add(new ProductViewModel
                {
                    Number = row["Mã SP"],
                    Name = row["Tên Sản phẩm"],
                    GroupCode = row["Nhóm SP (Mã)"],
                    Unit = row["Đơn vị tính"],
                    SellingPrice = decimal.TryParse(row["Giá bán"], out decimal sp) ? sp : 0,
                    Cosprice = decimal.TryParse(row["Giá vốn"], out decimal cp) ? cp : 0
                });
            }
            
            Snackbar.Add($"Đọc file thành công. Vui lòng kiểm tra dữ liệu và Xác nhận Import.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi nhập file: {ex.Message}", Severity.Error, config => { config.RequireInteraction = true; });
        }
    }

    private void CancelImport()
    {
        previewData = null;
    }

    private async Task ConfirmImport()
    {
        if (previewData == null) return;
        
        int successCount = 0;
        int failCount = 0;
        
        foreach (var vm in previewData)
        {
            var res = await ProductService.SaveProductAsync(vm, "admin_import");
            if (res.IsSuccess) successCount++;
            else failCount++;
        }
        
        if (failCount == 0)
            Snackbar.Add($"Nhập thành công {successCount}/{previewData.Count} bản ghi.", Severity.Success);
        else
            Snackbar.Add($"Thành công {successCount}, Thất bại {failCount}.", Severity.Warning, config => { config.RequireInteraction = true; });
        
        previewData = null;
        await LoadData();
    }
}
