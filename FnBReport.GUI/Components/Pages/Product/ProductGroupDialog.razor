@using FnBReport.GUI.ViewModels
@using FnBReport.GUI.Services
@inject IProductAppService ProductService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <EditForm Model="@Model" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Number" Label="Mã Nhóm" For="@(() => Model.Number)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Name" Label="Tên Nhóm" For="@(() => Model.Name)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Category" Label="Danh mục (Category)" For="@(() => Model.Category)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Hủy</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnValidSubmit">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public ProductGroupViewModel Model { get; set; } = new();

    private async Task OnValidSubmit()
    {
        var result = await ProductService.SaveProductGroupAsync(Model, "admin");
        if (result.OK)
        {
            Snackbar.Add(Model.Id == 0 ? "Thêm nhóm thành công" : "Cập nhật nhóm thành công", Severity.Success);
            MudDialog.Close(DialogResult.Ok(Model));
        }
        else
        {
            // Yêu cầu: Show nguyên văn lỗi DB
            Snackbar.Add(result.Message, Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
