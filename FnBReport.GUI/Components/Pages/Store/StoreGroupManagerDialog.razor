<MudDialog>
    <DialogContent>
        <StoreGroupManager />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Close">Xong</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private void Close()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }
}
