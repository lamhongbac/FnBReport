@using FnBReport.GUI.Components.Pages.MonthlySale
@inject IDialogService DialogService

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Trang chủ</MudNavLink>
    
    <MudNavGroup Title="Quản lý Danh mục" Icon="@Icons.Material.Filled.Settings" Expanded="true">
        <MudNavLink Href="stores" Icon="@Icons.Material.Filled.Storefront">Cửa hàng</MudNavLink>
        <MudNavLink Href="store-groups" Icon="@Icons.Material.Filled.Category">Nhóm Cửa hàng</MudNavLink>
        <MudNavLink Href="products" Icon="@Icons.Material.Filled.Fastfood">Sản phẩm</MudNavLink>
        <MudNavLink Href="product-groups" Icon="@Icons.Material.Filled.Kitchen">Nhóm Sản phẩm</MudNavLink>
    </MudNavGroup>
    
    <MudNavGroup Title="Báo cáo" Icon="@Icons.Material.Filled.InsertChart" Expanded="true">
        <MudNavLink OnClick="OpenMonthlySaleInitDialog" Icon="@Icons.Material.Filled.BarChart">Nhập Báo cáo Bán hàng</MudNavLink>
    </MudNavGroup>
    
    <MudNavGroup Title="Công cụ" Icon="@Icons.Material.Filled.Build">
        <MudNavLink Href="counter" Icon="@Icons.Material.Filled.Add">Counter</MudNavLink>
        <MudNavLink Href="weather" Icon="@Icons.Material.Filled.Cloud">Thời tiết</MudNavLink>
    </MudNavGroup>
</MudNavMenu>

@code {
    private async Task OpenMonthlySaleInitDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<MonthlySaleInitDialog>("Khởi tạo Báo cáo Bán hàng", options);
    }
}
